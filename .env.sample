# Copy to .env and fill in. No keys or SAS tokens: auth is DefaultAzureCredential.

# Windows local demo/task interpreter with requirements-dev.txt installed.
# PYTHON_EXECUTABLE=C:\path\to\venv\Scripts\python.exe
# Temporary local diagnostic bypass only; production review is unaffected.
SHOWCASE_SKIP_REVIEW=false
# Storage-free mode needs only this interpreter, Translator, Document Intelligence,
# Foundry configuration and pinned agent versions; leave cloud pipeline settings unused.

# Translator resource custom-subdomain endpoint
TRANSLATOR_ENDPOINT=https://<your-translator>.cognitiveservices.azure.com
# Storage account blob endpoint
STORAGE_BLOB_ENDPOINT=https://<your-storage>.blob.core.windows.net
# API, state and extraction (azd provision outputs these)
STORAGE_TABLE_ENDPOINT=https://<your-storage>.table.core.windows.net
DOCINTEL_ENDPOINT=https://<your-docintel>.cognitiveservices.azure.com
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/translation
FOUNDRY_MODEL_NAME=translation-reviewer
# Optional custom metrics; endpoint identifier only, authentication uses DefaultAzureCredential.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# Optional per-role deployment overrides. The checker defaults to GPT-6 Luna when configured.
TERM_GUARD_MODEL_NAME=
CHECKER_MODEL_NAME=
# Defaults to GPT6_LUNA_DEPLOYMENT_TYPE when blank.
CHECKER_DEPLOYMENT_TYPE=
CHECKER_INPUT_RATE_DATAZONE=
CHECKER_OUTPUT_RATE_DATAZONE=
CHECKER_INPUT_RATE_GLOBAL=
CHECKER_OUTPUT_RATE_GLOBAL=
# Enable independent parallel review by setting both; blank model preserves single-checker behavior.
MISTRAL_CHECKER_MODEL_NAME=
# Secondary reviewer only: leave blank for models without reasoning support (including Mistral).
CHECKER_REASONING_EFFORT=
# Per-reviewer request timeout. Only pre-connection errors get one retry; timeouts do not.
CHECKER_TIMEOUT_SECONDS=600
# Local workflow only: 1-4 chunks reviewed concurrently. Both configured reviewers check each chunk.
LOCAL_REVIEW_PARALLEL_CHUNKS=2
FOUNDRY_MODEL_ENDPOINT=https://<your-foundry>.services.ai.azure.com/openai/v1/
# Local translation comparison only; deployment name must exist and support the Responses API.
TRANSLATION_MODEL_NAME=gpt-6-luna
# Translation POC engine defaults and comparison deployments. Use deployment names from Foundry.
TRANSLATION_ENGINE=translator
TRANSLATOR_DEPLOYMENT_NAME=standard-nmt
TRANSLATOR_DEPLOYMENT_TYPE=Regional
TRANSLATOR_MODEL_VERSION=
TRANSLATOR_DOCUMENT_API_VERSION=2026-03-01
TRANSLATOR_TEXT_API_VERSION=3.0
TRANSLATOR_SYNC_API_VERSION=2024-05-01
DOC_LLM_MODEL_NAME=
DOC_LLM_DEPLOYMENT_NAME=
DOC_LLM_DEPLOYMENT_TYPE=Global
DOC_LLM_MODEL_VERSION=
DOC_LLM_API_VERSION=2026-03-01
GPT6_LUNA_MODEL_NAME=gpt-6-luna
GPT6_LUNA_DEPLOYMENT_NAME=
GPT6_LUNA_DEPLOYMENT_TYPE=DataZone
GPT6_LUNA_MODEL_VERSION=2026-09-22
GPT6_LUNA_REASONING_EFFORT=low
GPT6_1_TERRA_MODEL_NAME=gpt-6.1-terra
GPT6_1_TERRA_DEPLOYMENT_NAME=
GPT6_1_TERRA_DEPLOYMENT_TYPE=DataZone
GPT6_1_TERRA_MODEL_VERSION=2026-10-26
GPT6_1_TERRA_REASONING_EFFORT=low
GPT5_6_LUNA_MODEL_NAME=gpt-5.6-luna
GPT5_6_LUNA_DEPLOYMENT_NAME=
GPT5_6_LUNA_DEPLOYMENT_TYPE=DataZone
GPT5_6_LUNA_MODEL_VERSION=2026-07-09
GPT5_6_LUNA_REASONING_EFFORT=low
RESPONSES_API_VERSION=v1
GLOSSARY_MODE=static
# Optional CSV/TSV file with language-code headers such as it,en,es; defaults to insurance-standard.tsv.
GLOSSARY_PATH=
GLOSSARY_RETRIEVAL_LIMIT=20
HYBRID_ROUTING=false
# Optional per-million-token prices; blank rates keep estimated cost explicitly unknown.
GPT6_LUNA_INPUT_RATE_GLOBAL=
GPT6_LUNA_OUTPUT_RATE_GLOBAL=
GPT6_LUNA_INPUT_RATE_DATAZONE=
GPT6_LUNA_OUTPUT_RATE_DATAZONE=
GPT6_1_TERRA_INPUT_RATE_GLOBAL=
GPT6_1_TERRA_OUTPUT_RATE_GLOBAL=
GPT6_1_TERRA_INPUT_RATE_DATAZONE=
GPT6_1_TERRA_OUTPUT_RATE_DATAZONE=
GPT5_6_LUNA_INPUT_RATE_GLOBAL=
GPT5_6_LUNA_OUTPUT_RATE_GLOBAL=
GPT5_6_LUNA_INPUT_RATE_DATAZONE=
GPT5_6_LUNA_OUTPUT_RATE_DATAZONE=
TRANSLATOR_CHARACTER_RATE_REGIONAL=
TRANSLATOR_CHARACTER_RATE_GLOBAL=
DOC_LLM_CHARACTER_RATE_GLOBAL=
# Set both for direct GPT translation through an exact agent version; refinement still uses the model.
TRANSLATION_AGENT_NAME=
TRANSLATION_AGENT_VERSION=
TRANSLATION_CONTEXT_TOKENS=3000
TRANSLATION_MAX_OUTPUT_TOKENS=8192
# Optional Foundry Prompt Agent comparison deployments; these are separate from TRANSLATION_MODEL_NAME.
TRANSLATION_GPT_AGENT_MODEL_NAME=gpt-5.4-mini
TRANSLATION_MISTRAL_AGENT_MODEL_NAME=translation-mistral
TERM_GUARD_VERSION=
CHECKER_VERSION=
API_BASE_URL=https://<your-function>.azurewebsites.net/api
API_CLIENT_ID=
API_ALLOWED_AUDIENCE=api://<api-client-id>
AZURE_TENANT_ID=
# Provisioning inputs (configure through azd; choose actual supported values)
# FOUNDRY_BASE_MODEL_NAME=<model-name>
# FOUNDRY_MODEL_VERSION=<model-version>
# FOUNDRY_MODEL_SKU=<deployment-sku>
# FOUNDRY_MODEL_CAPACITY=<approved-capacity>

# Microsoft Graph: exact, comma-separated tenant hosts; no wildcards
SHAREPOINT_HOSTS=<tenant>.sharepoint.com,<tenant>-my.sharepoint.com
# Required on Flex Consumption for PPTX image OCR (renderer/ provides the service)
SLIDE_RENDER_URL=https://<your-renderer>/render
SLIDE_RENDER_SCOPE=api://<renderer-client-id>/.default

MAX_BASE64_MB=10
MAX_MULTIPART_MB=40
MAX_DOCUMENT_MB=40
MAX_GLOSSARY_MB=10
MAX_UNCOMPRESSED_MB=200
MAX_RENDERED_MB=80
PASS_THRESHOLD=85
# Optional JSON overrides for penalty weights and custom ID regular expressions:
PASS_A_WEIGHTS_JSON={}
# ID_REGEXES_JSON=["(?i)\\b(?:POL|SIN|SIE|CLM)\\s*-\\s*[A-Z0-9]+(?:\\s*-\\s*[A-Z0-9]+)*\\b"]
# Locale overrides normally remain unset; defaults are derived from each job's languages.
# SOURCE_LOCALE=it_IT
# TARGET_LOCALE=en_US

# Local-only Azure Functions settings (use deployed DTS and storage with az login)
TASKHUB_NAME=
DURABLE_TASK_SCHEDULER_CONNECTION_STRING=Endpoint=https://<scheduler>;Authentication=DefaultAzure
# Do not set AZURE_CLIENT_ID locally: that selects the deployed user-assigned MI instead of az login.
# Explicit unauthenticated local development only; rejected when WEBSITE_INSTANCE_ID is present:
# AZURE_FUNCTIONS_ENVIRONMENT=Development
# ALLOW_LOCAL_AUTH_BYPASS=1
