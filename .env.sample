# Copy to .env and fill in. No keys or SAS tokens: auth is DefaultAzureCredential.

# Translator resource custom-subdomain endpoint
TRANSLATOR_ENDPOINT=https://<your-translator>.cognitiveservices.azure.com
# Storage account blob endpoint
STORAGE_BLOB_ENDPOINT=https://<your-storage>.blob.core.windows.net
# API, state and extraction (azd provision outputs these)
STORAGE_TABLE_ENDPOINT=https://<your-storage>.table.core.windows.net
DOCINTEL_ENDPOINT=https://<your-docintel>.cognitiveservices.azure.com
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/translation
FOUNDRY_MODEL_NAME=translation-reviewer
TERM_GUARD_VERSION=
CHECKER_VERSION=
API_BASE_URL=https://<your-function>.azurewebsites.net/api
API_CLIENT_ID=
API_ALLOWED_AUDIENCE=api://<api-client-id>
AZURE_TENANT_ID=
# Provisioning inputs (configure through azd; choose actual supported values)
# FOUNDRY_BASE_MODEL_NAME=<model-name>
# FOUNDRY_MODEL_VERSION=<model-version>
# FOUNDRY_MODEL_SKU=<deployment-sku>
# FOUNDRY_MODEL_CAPACITY=<approved-capacity>

# Microsoft Graph: exact, comma-separated tenant hosts; no wildcards
SHAREPOINT_HOSTS=<tenant>.sharepoint.com,<tenant>-my.sharepoint.com
# Required on Flex Consumption for PPTX image OCR (renderer/ provides the service)
SLIDE_RENDER_URL=https://<your-renderer>/render
SLIDE_RENDER_SCOPE=api://<renderer-client-id>/.default

MAX_BASE64_MB=10
MAX_MULTIPART_MB=40
MAX_DOCUMENT_MB=40
MAX_GLOSSARY_MB=10
MAX_UNCOMPRESSED_MB=200
MAX_RENDERED_MB=80
PASS_THRESHOLD=85
# Optional JSON overrides for penalty weights and custom ID regular expressions:
PASS_A_WEIGHTS_JSON={}
# ID_REGEXES_JSON=["(?i)\\b(?:POL|SIN|SIE|CLM)\\s*-\\s*[A-Z0-9]+(?:\\s*-\\s*[A-Z0-9]+)*\\b"]
# Locale overrides normally remain unset; defaults are derived from each job's languages.
# SOURCE_LOCALE=it_IT
# TARGET_LOCALE=en_US

# Local-only Azure Functions settings (use deployed DTS and storage with az login)
TASKHUB_NAME=
DURABLE_TASK_SCHEDULER_CONNECTION_STRING=Endpoint=https://<scheduler>;Authentication=DefaultAzure
# Do not set AZURE_CLIENT_ID locally: that selects the deployed user-assigned MI instead of az login.
# Explicit unauthenticated local development only; rejected when WEBSITE_INSTANCE_ID is present:
# AZURE_FUNCTIONS_ENVIRONMENT=Development
# ALLOW_LOCAL_AUTH_BYPASS=1
